# AURUM XAU backend configuration. Copy to .env and fill in. NEVER commit the real .env file.

# --- Required ------------------------------------------------------------------------------
# Long random secret the Android app sends as its bearer token (min 16 chars).
# Leave empty to auto-generate one on first start (printed in the log, saved in data/api-token.txt).
AURUM_API_TOKEN=

# Data source: demo | jforex | datafeed
#   demo     = synthetic data, clearly labelled DEMO DATA (no account needed) — for trying the app
#   jforex   = official Dukascopy JForex SDK, real live ticks (needs a Dukascopy demo or live account)
#   datafeed = Dukascopy public historical archive only, labelled HISTORICAL ONLY, never live, no signals
AURUM_DATA_MODE=demo

# --- Dukascopy JForex (when AURUM_DATA_MODE=jforex) ----------------------------------------
# Free demo account: https://www.dukascopy.com/swiss/english/forex/demo-fx-account/
AURUM_JFOREX_USER=
AURUM_JFOREX_PASSWORD=
# Demo server (default). For a live account use https://platform.dukascopy.com/live/jforex.jnlp
AURUM_JFOREX_JNLP_URL=https://platform.dukascopy.com/demo/jforex.jnlp

# --- AI explanations (optional; without a key a rule-based explanation is shown) -------------
# openai | deepseek | none
AURUM_AI_PROVIDER=none
AURUM_AI_API_KEY=
# Defaults: gpt-5-mini (openai), deepseek-chat (deepseek). Change if your account uses another model.
AURUM_AI_MODEL=

# --- Economic calendar ------------------------------------------------------------------------
# fairEconomy (public weekly feed, refreshed at most every 30 min) | file | none
AURUM_CALENDAR_PROVIDER=fairEconomy
# For "file": path to a JSON array [{"title","country","date","impact","forecast","previous","actual"}]
AURUM_CALENDAR_FILE=

# --- Push notifications (Expo push service; app build needs FCM credentials) ----------------
AURUM_PUSH_ENABLED=true
AURUM_EXPO_ACCESS_TOKEN=

# --- Optional MT5/Exness price comparison (mt5/AurumBridge.mq5) ------------------------------
AURUM_BROKER_FEED_TOKEN=

# --- Server ----------------------------------------------------------------------------------
AURUM_PORT=8080
AURUM_DATA_DIR=./data
